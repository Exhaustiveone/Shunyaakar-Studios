# Copy to backend/.env for local runs (never commit the real file). On Render, set these in the dashboard.

# Supabase → Connect → Session pooler URI (port 5432) or Transaction pooler (6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The one account that can open /desk. Stored in the database with role "admin".
ADMIN_EMAIL=you@example.com
# Only for the first start: sets the admin's password if it has none. Remove afterwards.
# (Or leave it out and run `npm run create-admin` instead.) At least 12 characters.
ADMIN_PASSWORD=

# Optional
# ADMIN_PASSWORD_RESET=true        # with ADMIN_PASSWORD: replace the existing password once, signs out all sessions
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...   # Supabase CA (Project Settings → Database → SSL) to verify the DB certificate
# SESSION_HOURS=72                 # how long a desk sign-in lasts
# ALLOWED_ORIGINS=https://old-site.netlify.app   # other sites allowed to post the two forms
# PORT=3000
